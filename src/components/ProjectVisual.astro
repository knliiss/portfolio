---
import type { Project } from '../data/content';
import { pathFor } from '../data/content';

interface Props {
  project: Project;
  detail?: boolean;
}
const { project, detail = false } = Astro.props;
---
<div class={'project-art project-art--' + project.visual + (detail ? ' project-art--detail' : '')}>
  {project.visual === 'mnemos' && (
    <div class="art-content art-mnemos">
      <div class="art-head">
        <span class="art-brand">M<span class="art-brand-point">.</span></span>
        <span class="art-overline">MNEMOS / ACCOUNT HOME</span>
      </div>
      <div class="mnemos-visual-body">
        <div class="mnemos-visual-copy">
          <span class="mnemos-visual-tag">EVENTS · ACCOUNTS · REALTIME</span>
          <strong>Mnemos</strong>
          <span class="mnemos-visual-footnote">~150 people using the platform</span>
        </div>
        <div class="mnemos-device">
          <div class="mnemos-device-top" aria-hidden="true"><i></i><i></i><i></i><span>MNEMOS</span></div>
          <img src={pathFor('media/mnemos/home.webp')} alt="Real Mnemos application account home: active events, daily rewards, wallet, roles, teams and activity" loading={detail ? 'eager' : 'lazy'} decoding="async" width="480" height="891" />
        </div>
      </div>
      <div class="art-bottom"><span>KOTLIN / KAFKA / REACT</span><span>APPLICATION INTERFACE</span></div>
    </div>
  )}
  {project.visual === 'wavecode' && (
    <div class="art-content art-wavecode">
      <div class="art-head">
        <div class="wave-heading">
          <img src={pathFor('media/wavecode/mark.svg')} alt="" width="38" height="38" aria-hidden="true" />
          <span class="art-brand-word">wavecode</span>
        </div>
        <span class="art-overline">V1 / OPTICAL MEDIA CODE</span>
      </div>
      <div class="code-sheet">
        <span class="code-sheet-label">A REAL DECODABLE FRAME</span>
        <img src={pathFor('media/wavecode/example.svg')} alt="Real 36-column encoded WaveCode frame, generated by the author's Rust library" loading={detail ? 'eager' : 'lazy'} width="960" height="240" />
        <div class="code-sheet-bottom"><span>36 COLUMNS</span><span>RUST · SVG</span></div>
      </div>
      <div class="art-bottom"><span>ENCODE / SCAN / OPEN</span><span>RUST-ENCODED SAMPLE</span></div>
    </div>
  )}
  {project.visual === 'c7x' && (
    <div class="art-content art-c7x">
      <div class="art-head"><span class="art-brand-word">C7x<span class="art-brand-point">.</span></span><span class="art-overline">HEADLESS RUNTIME / JAVA + GO</span></div>
      <div class="art-c7x-center">
        <div class="c7x-total"><span>UP TO</span><strong>500</strong><span>CONCURRENT CLIENT SESSIONS</span></div>
        <div class="c7x-layer"><span class="c7x-layer-id">01</span><div><strong>Desktop manager</strong><small>Native Go shell · WebView2 · account controls</small></div></div>
        <div class="c7x-layer"><span class="c7x-layer-id">02</span><div><strong>Session orchestration</strong><small>Java application + runtime · lifecycle</small></div></div>
        <div class="c7x-layer"><span class="c7x-layer-id">03</span><div><strong>Shared transport</strong><small>Java NIO · proxy pools · protocol handling</small></div></div>
      </div>
      <div class="art-bottom"><span>NETWORK & SESSIONS</span><span>ARCHITECTURE</span></div>
    </div>
  )}
  {project.visual === 'studium' && (
    <div class="art-content art-studium">
      <div class="art-head"><span class="art-brand-word">studium<span class="art-brand-point">.</span></span><span class="art-overline">FULL-STACK LMS</span></div>
      <div class="studium-shot">
        <div class="shot-chrome"><span class="shot-dots"><i></i><i></i><i></i></span><span>Student workspace / actual screenshot</span></div>
        <img src={pathFor('media/studium/student.png')} alt="Actual student dashboard of the Studium learning management system" loading={detail ? 'eager' : 'lazy'} decoding="async" width="1365" height="768" />
      </div>
      <div class="art-bottom"><span>STUDENT / TEACHER / ADMIN</span><span>APPLICATION INTERFACE</span></div>
    </div>
  )}
</div>
