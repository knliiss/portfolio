---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { projects, languages, ui, profile, pathFor, type Language } from '../../data/content';
export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}
const { lang: rawLang } = Astro.params;
const lang = rawLang as Language;
const copy = ui[lang];
const route = lang + '/';
---
<BaseLayout lang={lang} route={route} title="Software Engineer" description={copy.intro}>
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-content">
        <span class="eyebrow"><span class="dot"></span>{copy.eyebrow}</span>
        <h1 id="hero-title">{copy.headline}</h1>
        <div class="hero-meta">
          <p class="hero-intro">{copy.intro}</p>
        </div>
        <div class="hero-actions">
          <a href="#work" class="button">{copy.explore}<span aria-hidden="true">↗</span></a>
          <a href={pathFor(lang + '/resume/')} class="text-link">{copy.viewResume}<span class="arrow" aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
    <section id="work" class="section" aria-labelledby="work-title">
      <div class="section-header">
        <span class="eyebrow">{copy.featuredLabel}</span>
        <div class="section-title-wrap">
          <h2 id="work-title">Selected work<span aria-hidden="true">.</span></h2>
          <p class="section-intro">{copy.featuredIntro}</p>
        </div>
      </div>
      <div class="work-list">
        {projects.map((project) => {
          const text = project.copy[lang];
          const href = pathFor(lang + '/work/' + project.slug + '/');
          return (
            <article class="project-card">
              <a href={href} class="project-card-art" aria-label={project.slug + ' — ' + copy.viewWork}>
                <ProjectVisual project={project} />
              </a>
              <div class="project-card-copy">
                <span class="project-number">{project.order} / {text.category}</span>
                <h3><a href={href}>{project.slug === 'c7xbotmanager' ? 'C7xBotManager' : project.slug === 'wavecode' ? 'WaveCode' : project.slug === 'studium' ? 'Studium' : 'Mnemos'}</a></h3>
                <p class="project-subtitle">{text.subtitle}</p>
                <div class="tech-line" aria-label={copy.coreTech}>
                  {project.technologies.slice(0, 4).map((tech) => <span class="pill">{tech}</span>)}
                </div>
                <a href={href} class="text-link">{copy.viewWork}<span class="arrow" aria-hidden="true">↗</span></a>
                <p class="project-metric">{text.resultLabel}</p>
              </div>
            </article>
          );
        })}
      </div>
    </section>
    <section id="about" class="section" aria-labelledby="about-title">
      <div class="section-header">
        <span class="eyebrow">{copy.focusLabel}</span>
        <div class="section-title-wrap">
          <h2 id="about-title">{copy.focusHeadline}</h2>
          <p class="section-intro">{copy.focusIntro}</p>
        </div>
      </div>
      <div class="focus-grid">
        {copy.focusItems.map((item, index) => (
          <div class="focus-item">
            <span class="focus-index">0{index + 1}</span>
            <h3>{item[0]}</h3>
            <p>{item[1]}</p>
          </div>
        ))}
      </div>
    </section>
    <section class="section" aria-labelledby="awards-title">
      <div class="section-header">
        <span class="eyebrow">{copy.awardsLabel}</span>
        <div class="section-title-wrap"><h2 id="awards-title">{copy.awardsHeading}</h2><p class="section-intro">{copy.awardsIntro}</p></div>
      </div>
      <div class="recognition">
        <div class="award-list">
          {copy.awards.map((award) => (
            <div class="award-item">
              <span class="award-year">{award[0]}</span>
              <div>
                <p class="award-name">{award[1]}</p>
                {award[2] && <p class="award-detail">{award[2]}</p>}
              </div>
            </div>
          ))}
        </div>
        <div class="education-panel">
          <span class="eyebrow">{copy.education}</span>
          <h3>{copy.school}</h3>
          <p>{copy.studying}</p>
        </div>
      </div>
    </section>
    <section id="contact" class="contact-section" aria-labelledby="contact-title">
      <hr class="rule" />
      <span class="eyebrow" style="margin-top:29px">{copy.contactLabel}</span>
      <h2 class="contact-title" id="contact-title">{copy.contactTitle}</h2>
      <p class="contact-subtitle">{copy.contactIntro}</p>
      <div class="contact-links">
        <a class="button" href={'mailto:' + profile.email}>{copy.emailMe}<span aria-hidden="true">↗</span></a>
        <a class="text-link" href={profile.github} rel="noopener noreferrer" target="_blank">GitHub <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={profile.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={pathFor(lang + '/resume/')}>{copy.viewResume} <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</BaseLayout>
