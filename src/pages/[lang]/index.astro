---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { projects, languages, ui, profile, pathFor, type Language } from '../../data/content';
import { narratives } from '../../data/stories';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const copy = ui[lang];
const route = lang + '/';
const isUk = lang === 'uk';
const projectName = (slug: string) => slug === 'c7xbotmanager' ? 'C7xBotManager' : slug === 'wavecode' ? 'WaveCode' : slug === 'studium' ? 'Studium' : 'Mnemos';
import ArrowIcon from '../../components/ArrowIcon.astro';
---
<BaseLayout lang={lang} route={route} title="Software Engineer" description={copy.intro}>
  <div class="container">
    <section class="new-hero" aria-labelledby="main-title">
      <div class="new-hero-index">
        <span class="eyebrow"><span class="dot"></span>{copy.eyebrow}</span>
        <span class="small muted">{isUk ? 'Незалежна розробка продуктів' : 'Independent product engineering'}</span>
      </div>
      <div class="new-hero-body">
        <h1 id="main-title">{isUk ? 'Backend-системи. Програмні продукти.' : 'Backend systems. Software products.'}</h1>
        <div class="new-hero-foot">
          <p>{copy.intro}</p>
          <div class="new-hero-actions">
            <a class="button" href="#work">{copy.explore} <ArrowIcon direction="down" /></a>
            <a class="text-link" href={pathFor(lang + '/resume/')}>{copy.viewResume} <ArrowIcon direction="right" /></a>
          </div>
        </div>
      </div>
    </section>

    <div class="proof-row" aria-label={isUk ? 'Перевірені результати' : 'Selected proof points'}>
      <div><strong>~150</strong><span>{isUk ? 'Користувачів Mnemos' : 'Mnemos product users'}</span></div>
      <div><strong>500</strong><span>{isUk ? 'До 500 одночасних сесій у C7x' : 'Concurrent C7x sessions, up to'}</span></div>
      <div><strong>1st</strong><span>{isUk ? 'BEC 2026 · Innovative Design' : 'BEC 2026 · Innovative Design'}</span></div>
    </div>

    <section id="work" class="portfolio-section" aria-labelledby="work-title">
      <header class="folio-section-head">
        <span class="eyebrow">{copy.featuredLabel}</span>
        <div>
          <h2 id="work-title">{isUk ? 'Мої проєкти.' : 'Selected projects.'}</h2>
          <p class="section-description">{isUk ? 'Розподілені сервіси, оптичний формат для медіа, мережевий runtime і навчальна платформа. Кожен кейс містить реалізацію, архітектуру та результат.' : 'Distributed services, an optical media format, a concurrent network runtime and a learning platform. Each case covers architecture, implementation and outcome.'}</p>
        </div>
      </header>
      <div class="showcase-list">
        {projects.map((project) => {
          const story = narratives[project.slug][lang];
          const label = projectName(project.slug);
          const link = pathFor(lang + '/work/' + project.slug + '/');
          const liveUrl = project.slug === 'wavecode' ? project.live : undefined;
          const mainUrl = link;
          return (
            <article class="showcase-item">
              <a class="showcase-art" href={link} aria-label={label + ' — ' + copy.viewWork}>
                <ProjectVisual project={project} />
              </a>
              <div class="showcase-info">
                <div class="showcase-summary">
                  <span class="eyebrow">{project.order} / {project.copy[lang].category}</span>
                  <h3><a href={link}>{label}</a></h3>
                </div>
                <div class="showcase-details">
                  <p class="showcase-lede">{story.introduction[0]}</p>
                  <div class="showcase-tech">{project.technologies.slice(0, 4).map(tech => <span>{tech}</span>)}</div>
                  {liveUrl ? (
                    <div class="showcase-actions">
                      <a class="text-link" href={link}>{isUk ? 'Про реалізацію' : 'Explore the case'} <ArrowIcon direction="right" /></a>
                      <a class="text-link showcase-secondary-link" href={liveUrl} target="_blank" rel="noopener noreferrer">{isUk ? 'Відкрити сканер' : 'Open scanner'} <ArrowIcon direction="up-right" /></a>
                    </div>
                  ) : (
                    <a class="text-link" href={link}>{isUk ? 'Кейс із прикладом' : 'Read the engineering case'} <ArrowIcon direction="right" /></a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section id="about" class="portfolio-section" aria-labelledby="about-title">
      <header class="folio-section-head">
        <span class="eyebrow">{copy.focusLabel}</span>
        <div><h2 id="about-title">{copy.focusHeadline}</h2><p class="section-description">{copy.focusIntro}</p></div>
      </header>
      <div class="focus-rows">
        {copy.focusItems.map((item, index) => (
          <div class="focus-row"><span>0{index + 1}</span><h3>{item[0]}</h3><p>{item[1]}</p></div>
        ))}
      </div>
    </section>

    <section class="portfolio-section" aria-labelledby="recognition-title">
      <header class="folio-section-head">
        <span class="eyebrow">{copy.awardsLabel}</span>
        <div><h2 id="recognition-title">{copy.awardsHeading}</h2><p class="section-description">{copy.awardsIntro}</p></div>
      </header>
      <div class="recognition-layout">
        <div class="recognition-list">
          {copy.awards.map(award => <div class="recognition-item"><span>{award[0]}</span><div><h3>{award[1]}</h3>{award[2] && <p>{award[2]}</p>}</div></div>)}
        </div>
        <div class="education-block"><span class="eyebrow">{copy.education}</span><h3>{copy.school}</h3><p>{copy.studying}</p></div>
      </div>
    </section>

    <section id="contact" class="new-contact" aria-labelledby="contact-title">
      <span class="eyebrow">{copy.contactLabel}</span>
      <h2 id="contact-title">{isUk ? 'Створімо щось корисне.' : "Let's build something useful."}</h2>
      <p>{copy.contactIntro}</p>
      <div class="contact-actions">
        <a class="button" href={'mailto:' + profile.email}>{copy.emailMe} <ArrowIcon direction="up-right" /></a>
        <a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <ArrowIcon direction="up-right" /></a>
        <a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <ArrowIcon direction="up-right" /></a>
      </div>
    </section>
  </div>
</BaseLayout>
