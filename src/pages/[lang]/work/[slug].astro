---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectVisual from '../../../components/ProjectVisual.astro';
import { projects, languages, ui, pathFor, type Language, type Project } from '../../../data/content';
import { narrativeFor } from '../../../data/stories';

export function getStaticPaths() {
  return languages.flatMap(lang => projects.map(project => ({
    params: { lang, slug: project.slug },
    props: { lang, project }
  })));
}

const { lang, project } = Astro.props as { lang: Language; project: Project };
const copy = ui[lang];
const story = narrativeFor(project.slug, lang);
const text = project.copy[lang];
const i = projects.findIndex(p => p.slug === project.slug);
const next = projects[(i + 1) % projects.length];
const projectName = (slug: string) => slug === 'c7xbotmanager' ? 'C7xBotManager' : slug === 'wavecode' ? 'WaveCode' : slug === 'studium' ? 'Studium' : 'Mnemos';
const name = projectName(project.slug);
const nextName = projectName(next.slug);
const route = lang + '/work/' + project.slug + '/';
const isUk = lang === 'uk';
const isPublic = project.slug === 'wavecode' || project.slug === 'studium';
const imageCaptions = isUk ? ['Кабінет викладача', 'Кабінет адміністратора'] : ['Teacher dashboard', 'Administrator dashboard'];
---
<BaseLayout lang={lang} route={route} title={name + ' — Engineering case study'} description={story.overview}>
  <div class="container">
    <header class="case-top">
      <a href={pathFor(lang + '/#work')} class="text-link">← {copy.backToWork}</a>
      <div class="case-top-grid">
        <span class="eyebrow">{project.order} / {story.kicker}</span>
        <div>
          <h1>{name}<span class="heading-period">.</span></h1>
          <p class="case-intro-text">{text.subtitle}</p>
        </div>
      </div>
      <div class="case-quick-facts">
        <div><span>{copy.role}</span><strong>{text.role}</strong></div>
        <div><span>{copy.status}</span><strong>{text.status}</strong></div>
        <div><span>{isUk ? 'Підсумок' : 'In brief'}</span><strong>{text.resultLabel}</strong></div>
      </div>
    </header>

    <div class="case-cover">
      <ProjectVisual project={project} detail />
    </div>
    <p class="case-cover-caption"><strong>{story.mediaLabel}.</strong> {story.mediaDescription}</p>

    <div class="case-story" aria-label={copy.caseStudy}>
      <section class="chapter" aria-labelledby="chapter-intro">
        <span class="chapter-index">01 / {copy.overview}</span>
        <div class="chapter-body">
          <h2 id="chapter-intro">{story.overviewHeading}</h2>
          <p class="chapter-lead">{story.overview}</p>
          <p>{story.context}</p>
        </div>
      </section>

      <section class="chapter" aria-labelledby="chapter-example">
        <span class="chapter-index">02 / {isUk ? 'Приклад із практики' : 'An example in practice'}</span>
        <div class="chapter-body">
          <span class="eyebrow">{story.scenarioLabel}</span>
          <h2 id="chapter-example">{story.scenarioHeading}</h2>
          <p class="chapter-lead">{story.scenario}</p>
          {project.slug === 'wavecode' && (
            <div class="real-code-block">
              <div class="real-code-meta"><span>WAVECODE / V1</span><span>36 OPTICAL COLUMNS</span></div>
              <img src={pathFor('media/wavecode/example.svg')} alt="Actual optically encoded music track generated by the WaveCode Rust encoder" width="960" height="240" loading="lazy" />
              <div class="real-code-foot">
                <span>{isUk ? 'Реальний приклад із Rust SDK' : 'Real sample produced by the Rust SDK'}</span>
                <a href="https://wavecode.knalis.rest/" target="_blank" rel="noopener noreferrer">{isUk ? 'Відсканувати код ↗' : 'Scan this code ↗'}</a>
              </div>
            </div>
          )}
          <div class="scenario-steps" aria-label={isUk ? 'Етапи процесу' : 'Process steps'}>
            {story.steps.map(step => (
              <div class="scenario-step">
                <span class="step-index">{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            ))}
          </div>
          {project.slug === 'wavecode' && (
            <div class="live-demo-callout">
              <div>
                <span class="eyebrow">{isUk ? 'Працюючий застосунок' : 'Working application'}</span>
                <h3>{isUk ? 'Повноцінний сканер і генератор' : 'The full scanner and generator'}</h3>
                <p>{isUk ? 'Камера, сканування фото, створення коду з посилання та експорт SVG/PNG. Усе працює через офіційний Rust WebAssembly SDK.' : 'Camera scanning, photo import, link encoding and SVG/PNG export, powered by the official Rust WebAssembly SDK.'}</p>
              </div>
              <a class="button" href="https://wavecode.knalis.rest/" target="_blank" rel="noopener noreferrer">{isUk ? 'Відкрити WaveCode' : 'Launch WaveCode'} <span aria-hidden="true">↗</span></a>
            </div>
          )}
        </div>
      </section>

      <section class="chapter" aria-labelledby="chapter-decisions">
        <span class="chapter-index">03 / {copy.engineering}</span>
        <div class="chapter-body">
          <h2 id="chapter-decisions">{story.decisionsHeading}</h2>
          <div class="decision-list">
            {story.decisions.map((decision, index) => (
              <div class="decision-row">
                <span class="decision-number">0{index + 1}</span>
                <h3>{decision.title}</h3>
                <p>{decision.reason}</p>
              </div>
            ))}
          </div>
          <div class="case-stack">
            <span class="eyebrow">{copy.coreTech}</span>
            <div class="tag-row">{project.technologies.map(tech => <span>{tech}</span>)}</div>
          </div>
        </div>
      </section>

      <section class="chapter" aria-labelledby="chapter-result">
        <span class="chapter-index">04 / {copy.outcome}</span>
        <div class="chapter-body">
          <h2 id="chapter-result">{story.outcomeHeading}</h2>
          <p class="chapter-lead">{story.outcome}</p>
          <p class="case-limits">{story.note}</p>
          <div class="case-external-links">
            {isPublic && <a href={project.repo} class="button" target="_blank" rel="noopener noreferrer">{copy.openSource} <span aria-hidden="true">↗</span></a>}
            {project.secondRepo && <a href={project.secondRepo} target="_blank" rel="noopener noreferrer" class="text-link">{copy.moreProject} <span aria-hidden="true">↗</span></a>}
            {!isPublic && <span class="private-note">{isUk ? 'Вихідний код приватний; інженерний опис доступний вище.' : 'Source code is private; the engineering case is documented above.'}</span>}
          </div>
        </div>
      </section>

      {project.slug === 'studium' && project.gallery && (
        <section class="case-gallery" aria-label={story.mediaLabel}>
          <div class="gallery-label"><span class="eyebrow">{isUk ? 'Справжні матеріали' : 'Real project material'}</span><h2>{isUk ? 'Інтерфейси різних ролей.' : 'The interface across roles.'}</h2></div>
          <div class="gallery-grid">
            {project.gallery.map((asset, idx) => (
              <figure>
                <div class="gallery-img"><img src={pathFor(asset)} alt={imageCaptions[idx] + ' of the real Studium application'} loading="lazy" decoding="async" /></div>
                <figcaption><span>0{idx + 2}</span> {imageCaptions[idx]}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}
    </div>

    <a class="case-next" href={pathFor(lang + '/work/' + next.slug + '/')}>
      <span class="case-next-copy"><small class="eyebrow">{copy.nextProject}</small><strong>{nextName}</strong></span>
      <span class="case-next-arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</BaseLayout>
