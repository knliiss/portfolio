---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectVisual from '../../../components/ProjectVisual.astro';
import { projects, languages, ui, pathFor, type Language, type Project } from '../../../data/content';
import { narrativeFor } from '../../../data/stories';

export function getStaticPaths() {
  return languages.flatMap(lang => projects.map(project => ({
    params: { lang, slug: project.slug },
    props: { lang, project }
  })));
}

const { lang, project } = Astro.props as { lang: Language; project: Project };
const t = ui[lang];
const story = narrativeFor(project.slug, lang);
const facts = project.copy[lang];
const isUk = lang === 'uk';
const name = ({ mnemos: 'Mnemos', wavecode: 'WaveCode', c7xbotmanager: 'C7xBotManager', studium: 'Studium' } as const)[project.slug];
const index = projects.findIndex(p => p.slug === project.slug);
const next = projects[(index + 1) % projects.length];
const nextName = ({ mnemos: 'Mnemos', wavecode: 'WaveCode', c7xbotmanager: 'C7xBotManager', studium: 'Studium' } as const)[next.slug];
const route = lang + '/work/' + project.slug + '/';
const isPublic = project.slug === 'wavecode' || project.slug === 'studium';

const mnemosScreens = [
  { file: 'events-global', en: 'Global events', uk: 'Глобальні події', altEn: 'Global-event feed and filters', altUk: 'Стрічка глобальних подій та фільтри' },
  { file: 'events-drops', en: 'Item drops', uk: 'Дропи', altEn: 'Item drops and player activity', altUk: 'Дропи та активність гравців' },
  { file: 'rankings', en: 'Leaderboards', uk: 'Рейтинг', altEn: 'Wipe leaderboards and coin balances', altUk: 'Рейтинг і баланс монет' },
  { file: 'profile', en: 'Player profile', uk: 'Профіль гравця', altEn: 'Online status, SAO realm and recent drops', altUk: 'Онлайн-стан, SAO-реалм та останні дропи' },
  { file: 'wallet', en: 'Wallet', uk: 'Гаманець', altEn: 'Coin exchange and account balance', altUk: 'Обмін монет і баланс акаунта' },
];
const galleryLabels = isUk ? ['Кабінет викладача', 'Кабінет адміністратора'] : ['Teacher workspace', 'Administrator workspace'];
const introductionHeadings = {
  mnemos: { en: 'Realtime events and everything around them', uk: 'Події, підписки та інші функції Mnemos' },
  wavecode: { en: 'An optical format for media links', uk: 'Оптичний формат для медіапосилань' },
  c7xbotmanager: { en: 'Managing headless clients without a full game', uk: 'Керування headless-клієнтами без запуску гри' },
  studium: { en: 'An LMS with distinct student and teacher workflows', uk: 'Навчальна платформа для різних ролей' }
};
const overviewLabel = isUk ? 'Про проєкт' : 'About the project';
const contributionLabel = isUk ? 'Реалізація' : 'Implementation';
const flowLabel = isUk ? 'Приклад реалізації' : 'A closer look';
const engineeringLabel = isUk ? 'Технічні рішення' : 'Implementation details';
const resultLabel = isUk ? 'Результат' : 'Outcome';
import ArrowIcon from '../../../components/ArrowIcon.astro';
---
<BaseLayout lang={lang} route={route} title={name + ' — ' + story.label} description={story.introduction[0]}>
  <div class="container">
    <header class="case-top">
      <div class="case-top-actions">
        <a href={pathFor(lang + '/#work')} class="text-link"><ArrowIcon direction="left" /> {t.backToWork}</a>
        {project.slug === 'wavecode' && (
          <a class="text-link" href="https://wavecode.knalis.rest/" target="_blank" rel="noopener noreferrer">{isUk ? 'Відкрити WaveCode' : 'Open WaveCode'} <ArrowIcon direction="up-right" /></a>
        )}
      </div>
      <div class="case-top-grid">
        <span class="eyebrow">{project.order} / {story.label}</span>
        <div>
          <h1>{name}<span class="heading-period">.</span></h1>
          <p class="case-intro-text">{facts.subtitle}</p>
        </div>
      </div>
      <div class="case-quick-facts">
        <div><span>{t.role}</span><strong>{facts.role}</strong></div>
        <div><span>{t.status}</span><strong>{facts.status}</strong></div>
        <div><span>{isUk ? 'Коротко' : 'In brief'}</span><strong>{facts.resultLabel}</strong></div>
      </div>
    </header>

    <div class="case-cover"><ProjectVisual project={project} detail /></div>
    <p class="case-cover-caption"><strong>{story.mediaLabel}.</strong> {story.mediaDescription}</p>

    <div class="case-story">
      <section class="chapter" aria-labelledby="chapter-overview">
        <span class="chapter-index">{overviewLabel}</span>
        <div class="chapter-body">
          <h2 id="chapter-overview">{introductionHeadings[project.slug][lang]}</h2>
          {story.introduction.map((paragraph, i) => <p class={i === 0 ? 'chapter-lead' : ''}>{paragraph}</p>)}
          {project.slug === 'mnemos' && (
            <figure class="mnemos-capture">
              <div class="mnemos-capture-image">
                <img src={pathFor('media/mnemos/home.webp')} width="480" height="891" loading="lazy" decoding="async" alt={isUk ? 'Справжній головний екран Mnemos: активний акаунт, події, нагороди, гаманець, команда та активність' : 'Actual Mnemos home screen showing account, live events, rewards, wallet, team and activity'} />
              </div>
              <figcaption>
                <span class="eyebrow">{isUk ? 'Інтерфейс продукту' : 'Product interface'}</span>
                <h3>{isUk ? 'Головна сторінка акаунта' : 'Account home'}</h3>
                <p>{isUk ? 'На цьому екрані об’єднані поточний акаунт, глобальні події, щоденні нагороди, баланс, члени команди й остання активність. Ці розділи працюють із даними різних сервісів Mnemos.' : 'This screen brings together the active account, global events, daily rewards, wallet balance, team members and recent activity. Those sections are backed by different parts of the Mnemos platform.'}</p>
                <a href={pathFor('media/mnemos/home.webp')} target="_blank" rel="noopener noreferrer" class="text-link">{isUk ? 'Відкрити скриншот' : 'View full screenshot'} <ArrowIcon direction="up-right" /></a>
              </figcaption>
            </figure>
          )}
          {project.slug === 'mnemos' && (
            <div class="mnemos-gallery">
              <div class="mnemos-gallery-head">
                <span class="eyebrow">{isUk ? 'Інтерфейс' : 'Product screens'}</span>
                <h3>{isUk ? 'Основні розділи' : 'Across the application'}</h3>
              </div>
              <div class="mnemos-gallery-grid" aria-label={isUk ? 'Скриншоти застосунку Mnemos' : 'Mnemos product screenshots'}>
                {mnemosScreens.map(screen => (
                  <figure class="mnemos-gallery-item">
                    <a href={pathFor('media/mnemos/' + screen.file + '.webp')} target="_blank" rel="noopener noreferrer"
                       aria-label={(isUk ? screen.uk : screen.en) + (isUk ? ' — відкрити скриншот' : ' — open screenshot')}>
                      <img src={pathFor('media/mnemos/' + screen.file + '.webp')} alt={isUk ? screen.altUk : screen.altEn}
                           loading="lazy" decoding="async" width="430" height="813" />
                    </a>
                    <figcaption>{isUk ? screen.uk : screen.en}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>

      <section class="chapter" aria-labelledby="chapter-contribution">
        <span class="chapter-index">{contributionLabel}</span>
        <div class="chapter-body">
          <h2 id="chapter-contribution">{isUk ? 'Ключові компоненти' : 'Key components'}</h2>
          <ul class="contribution-list">
            {story.responsibilities.map(point => <li>{point}</li>)}
          </ul>
        </div>
      </section>

      <section class="chapter" aria-labelledby="chapter-flow">
        <span class="chapter-index">{flowLabel}</span>
        <div class="chapter-body">
          <h2 id="chapter-flow">{story.example.title}</h2>
          <p class="chapter-lead">{story.example.introduction}</p>

          {project.slug === 'wavecode' && (
            <figure class="real-code-block">
              <div class="real-code-meta"><span>WAVECODE / V1</span><span>36 COLUMNS</span></div>
              <img src={pathFor('media/wavecode/example.svg')} alt={isUk ? 'Справжній оптичний код, сформований Rust-бібліотекою WaveCode' : 'Real optically encoded media identity generated by WaveCode Rust'} width="960" height="240" loading="lazy" />
              <figcaption class="real-code-foot">
                <span>{isUk ? 'Зразок з офіційної Rust-бібліотеки' : 'Sample from the Rust library'}</span>
                <a href="https://wavecode.knalis.rest/" target="_blank" rel="noopener noreferrer">{isUk ? 'Перевірити в сканері' : 'Try the scanner'} <ArrowIcon direction="up-right" /></a>
              </figcaption>
            </figure>
          )}

          <div class="scenario-steps">
            {story.example.steps.map((step, i) => (
              <div class="scenario-step">
                <span class="step-index">0{i + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            ))}
          </div>
          <p>{story.example.conclusion}</p>

          {project.slug === 'wavecode' && (
            <div class="live-demo-callout">
              <div>
                <span class="eyebrow">{isUk ? 'Сканер і генератор' : 'Scanner and generator'}</span>
                <h3>{isUk ? 'Спробувати WaveCode' : 'Use WaveCode'}</h3>
                <p>{isUk ? 'Живе сканування камерою, імпорт фото, створення кодів та експорт SVG/PNG — у повноцінному вебзастосунку.' : 'Live camera scanning, photo import, code creation and SVG/PNG export are available in the full web app.'}</p>
              </div>
              <a class="button" href="https://wavecode.knalis.rest/" target="_blank" rel="noopener noreferrer">{isUk ? 'Відкрити застосунок' : 'Open the app'} <ArrowIcon direction="up-right" /></a>
            </div>
          )}
        </div>
      </section>

      <section class="chapter" aria-labelledby="chapter-implementation">
        <span class="chapter-index">{engineeringLabel}</span>
        <div class="chapter-body">
          <h2 id="chapter-implementation">{isUk ? 'Технічні деталі' : 'Inside the implementation'}</h2>
          <div class="engineering-notes">
            {story.details.map((detail, i) => (
              <section class="engineering-note" aria-label={detail.title}>
                <div class="engineering-note-head">
                  <span class="step-index">0{i + 1}</span>
                  <h3>{detail.title}</h3>
                </div>
                <div class="engineering-note-text">
                  {detail.paragraphs.map(paragraph => <p>{paragraph}</p>)}
                </div>
              </section>
            ))}
          </div>
          <div class="case-stack">
            <span class="eyebrow">{t.coreTech}</span>
            <div class="tag-row">{project.technologies.map(tech => <span>{tech}</span>)}</div>
          </div>
        </div>
      </section>

      <section class="chapter" aria-labelledby="chapter-result">
        <span class="chapter-index">{resultLabel}</span>
        <div class="chapter-body">
          <h2 id="chapter-result">{isUk ? 'Результат' : 'Current outcome'}</h2>
          {story.outcome.map((paragraph, i) => <p class={i === 0 ? 'chapter-lead' : ''}>{paragraph}</p>)}
          <div class="case-external-links">
            {isPublic && <a href={project.repo} class="button" target="_blank" rel="noopener noreferrer">{t.openSource} <ArrowIcon direction="up-right" /></a>}
            {project.secondRepo && <a href={project.secondRepo} class="text-link" target="_blank" rel="noopener noreferrer">{t.moreProject} <ArrowIcon direction="up-right" /></a>}
          </div>
        </div>
      </section>

      {project.slug === 'studium' && project.gallery && (
        <section class="case-gallery" aria-labelledby="gallery-title">
          <div class="gallery-label">
            <span class="eyebrow">{isUk ? 'Інтерфейс' : 'Interface'}</span>
            <h2 id="gallery-title">{isUk ? 'Реальні екрани Studium' : 'Studium in use'}</h2>
          </div>
          <div class="gallery-grid">
            {project.gallery.map((asset, idx) => (
              <figure>
                <a class="gallery-img" href={pathFor(asset)} target="_blank" rel="noopener noreferrer" aria-label={galleryLabels[idx] + (isUk ? ': відкрити повний скриншот' : ': view full screenshot')}><img src={pathFor(asset)} alt={galleryLabels[idx] + (isUk ? ' — скриншот Studium' : ' — actual Studium screenshot')} loading="lazy" decoding="async" /></a>
                <figcaption><span>0{idx + 2}</span> {galleryLabels[idx]}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}
    </div>

    <a class="case-next" href={pathFor(lang + '/work/' + next.slug + '/')}>
      <span class="case-next-copy"><small class="eyebrow">{t.nextProject}</small><strong>{nextName}</strong></span>
      <span class="case-next-arrow"><ArrowIcon direction="right" size={42} /></span>
    </a>
  </div>
</BaseLayout>
